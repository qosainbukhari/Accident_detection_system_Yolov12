# Copy to backend/.env for local development. Never commit the copied file.
APP_ENV=development
DATABASE_URL=mysql+pymysql://accident_app:change-me@127.0.0.1:3306/accident_db
SECRET_KEY=replace-with-at-least-32-random-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1
ENABLE_DOCS=false

MODEL_PATH=ml_model/best.pt
DETECTION_CONFIDENCE=0.45
IOU_THRESHOLD=0.45
IMG_SIZE=640
ALERT_CLASSES=fire,moderate,severe
ALERT_COOLDOWN_SECONDS=60
VIDEO_FRAME_STRIDE=2
VIDEO_CONFIRMATION_FRAMES=3

MAX_UPLOAD_SIZE_MB=100
MAX_VIDEO_FRAMES=9000
MAX_IMAGE_PIXELS=25000000
UPLOAD_DIR=data/uploads
PROCESSED_DIR=static/processed
SNAPSHOTS_DIR=static/snapshots

# Optional outbound integrations. Leave blank to use safe mock/disabled mode.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
CALL_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EMERGENCY_CALL_TO=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AGENT_ENABLED=true
AGENT_TIMEOUT_SECONDS=30
WHATSAPP_ENABLED=false
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=
WHATSAPP_INCLUDE_MEDIA=false
PUBLIC_BASE_URL=
